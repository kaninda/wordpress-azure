server {
listen 80 default_server;
server_name _;
root {{ wp_dir }};
index index.php;

location = /healthz {
access_log off;
return 200 "ok\n";
}

location / {
try_files $uri $uri/ /index.php?$args;
}

location ~ \.php$ {
include snippets/fastcgi-php.conf;
fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
}

location ~ /\.ht {
deny all;
}
}
